<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-ci</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The ci REST boundary: `eu.wohlben.qits.ci.api` — the event intake, the run read surface,
         the static-token filter over the write surface, and the CiException -> HTTP mapper.
         Everything that needs a web stack and therefore cannot live in the framework-free `ci`
         module.

         A DEPLOYABLE APP, not a library JAR. It was extracted as a library — "a consuming Quarkus
         application pulls it in and gets the routes under its own `quarkus.rest.path`" — because
         packaging it would have needed an auth variant and a main class. Both reasons have lapsed:
         authentication terminates at qits-gateway and this module reads a header (see security/),
         and Quarkus supplies the main class.

         See migration-deployables-plan.md in the superproject.

         The directory stays `service/` because the extracted git history is anchored to it. -->
    <artifactId>qits-ci-service</artifactId>
    <name>qits-ci :: service</name>
    <packaging>quarkus</packaging>

    <dependencies>
        <dependency>
            <!-- /<segment>/q/health/ready - the readiness endpoint qits-cd's health gate curls;
                 the deployment convention every service answers. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-ci-domain</artifactId>
        </dependency>
        <dependency>
            <!-- The ci-daemon wire contract. Vendored into this repo (see that module's pom)
                 because it is published to no registry. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-ci-daemon-protocol</artifactId>
        </dependency>
        <dependency>
            <!-- The platform event bus client. Joining it here is what turns three library modules
                 into one deployable that publishes and listens: the outbox's datasource, its Flyway
                 lineage, the sweeper's @Scheduled job and the stream subscriber all arrive with
                 this jar, configured by the defaults it ships (its own
                 META-INF/microprofile-config.properties). The only thing this module says about it
                 is where it is dark — see application.properties.

                 It brings quarkus-scheduler, which is NEW to this deployable and the only extension
                 this dependency adds that was not already here (quarkus-websockets-next has been
                 present since the ci-daemon control plane, and this module's client half rides it).
                 quarkus-undertow stays absent, as Quinoa requires:
                 `./mvnw -pl service -am dependency:tree -Dincludes=io.quarkus:quarkus-undertow`
                 is still empty. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-eventstream</artifactId>
        </dependency>
        <dependency>
            <!-- qits-ci's event vocabulary — today just BuildSuccessful. Declared explicitly rather
                 than taken transitively through qits-eventstream above, because this module uses
                 the class by name in both directions (bus/BuildSuccessfulAnnouncer constructs it,
                 bus/BuildSuccessfulListener consumes it) and a compile-time use belongs in the pom
                 that makes it. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-ci-events</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <!-- The ci-daemon control socket (@WebSocket /ci/daemon, daemonhost/). A step
                 container's daemon dials it; qits-ci never dials in.

                 A native-image-supported extension, but this repo's rule is that the BINARY's ITs
                 are the proof rather than the extension's documentation — so CiPackagedSurfaceIT
                 asserts /ci/daemon is actually reachable on the packaged artifact. A `-Dnative`
                 build that silently dropped the endpoint fails there instead of at the first push
                 in a deployment. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-websockets-next</artifactId>
        </dependency>
        <dependency>
            <!-- OTLP export to qits-observability. The extension is what instruments the process;
                 the endpoint and protocol in application.properties are what make it arrive, since
                 the defaults are gRPC to localhost:4317 and the receiver speaks HTTP/protobuf. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <!-- SecurityIdentity + the HttpAuthenticationMechanism SPI, for the single thing this
                 service does about auth: read qits-gateway's X-Qits-User header into an identity
                 (see security/ForwardAuthMechanism). NOT an auth variant and NOT an authorization
                 policy — the monolith's -Dqits.variant auth/* modules do not come here at all;
                 authentication terminates at the gateway (migration-auth-plan.md). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- Builds and serves the Angular client at /ci (see application.properties). The
                 sources are the `qits-spa-ci` submodule at src/main/webui — Quinoa's default
                 `web-ui-dir`, so the path is a convention rather than a setting, and a fresh clone
                 needs the submodule initialised before this module builds.

                 NOT in the Quarkus platform BOM, so the version is pinned in the root pom next to
                 every other version this repo duplicates rather than inherits. 2.8.2 is the last
                 release built against a Quarkus OLDER than this repo's 3.34.6 (3.27.3 LTS); 2.8.3
                 moved to 3.36.2, which is ahead of the platform here.

                 quarkus-undertow must never join this module's dependencies: its presence breaks
                 Quinoa's production static serving, which is why qits-artifacts mounts its git host
                 on plain Vert.x routes (that repo's README, "The git host"). Nothing here pulls it
                 in today — `./mvnw -pl service -am dependency:tree -Dincludes=io.quarkus:quarkus-undertow`
                 is empty and quarkus-vertx-http is the only web stack present. -->
            <groupId>io.quarkiverse.quinoa</groupId>
            <artifactId>quarkus-quinoa</artifactId>
            <version>${quinoa.version}</version>
        </dependency>
        <dependency>
            <!-- @Valid on the intake payload. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <!-- @Operation(hidden = true): every ci endpoint is a wire/system API and stays out of
                 the consuming app's OpenAPI document. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- This module is the DEPLOYABLE, not a library jar, and `<packaging>quarkus</packaging>`
                     above is what says so: it binds generate-code, generate-code-tests and build into
                     the lifecycle, so augmentation stops being an execution block that can be
                     misplaced. One already was, in a sibling of this repo — declared under a `<build>`
                     whose `<testResources>` came first, so the goal never applied while `mvn verify`
                     stayed green and the deployable was never actually built. A packaging type cannot
                     fail quietly that way: drop the `<extensions>true</extensions>` below and the build
                     stops at "Unknown packaging: quarkus". Version comes from the root pom's
                     pluginManagement. -->
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- CiPackagedSurfaceIT and the docker-backed gates (CiDaemonHandshakeIT,
                     CiDaemonGateIT) bind here. skipITs=true is the parent's default, so a fresh
                     clone's `mvn verify` is green without docker; `-DskipITs=false` runs them all and
                     the gates self-skip (JUnit Assumptions) when docker, the step image or the daemon
                     binary is absent. The `native` profile flips skipITs too, but narrows to
                     CiPackagedSurfaceIT via qits.it.excluded-groups (see the root pom). -->
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <excludedGroups>${qits.it.excluded-groups}</excludedGroups>
                    <!-- The docker-backed ITs stand a server up in THIS JVM for a container to dial
                         back through host.docker.internal, and that only works if the JVM binds an
                         IPv4 listener. Left alone it binds a dual-stack IPv6 socket for 0.0.0.0 —
                         `ss -ltnp -f inet` shows nothing, `-f inet6` shows `*:<port>` — and docker's
                         host gateway forwards only IPv4, so the container cannot see it. The symptom
                         is not a connection error either: it is the register deadline expiring after
                         two minutes with `wget could not fetch` in the container's log, which reads
                         like a broken bootstrap rather than a host that cannot be reached.
                         Confirmed A/B on one host: a `python3 -m http.server` (IPv4) serving the same
                         file succeeds from the same container at the same moment the JVM's port
                         fails. It has to be an argLine because the JVM reads it when networking
                         initialises, before any test runs.
                         Harmless for the rest of the suite — CiPackagedSurfaceIT reaches its launched
                         artifact over loopback — and it is the same line qits-workspaces carries for
                         the same reason. The parent's `native` profile drops the docker-backed ITs
                         entirely, so this costs that build nothing either. -->
                    <argLine>-Djava.net.preferIPv4Stack=true</argLine>
                    <systemPropertyVariables>
                        <!-- How @QuarkusIntegrationTest finds the compiled binary in a `-Dnative`
                             build; without it the native run has nothing to launch. The name is
                             `quarkus.package.output-name` from application.properties, NOT maven's
                             finalName — with an output-name set, ${project.build.finalName}-runner
                             is a path that does not exist, and failsafe would silently launch
                             nothing. The two spellings move together. -->
                        <native.image.path>${project.build.directory}/qits-ci</native.image.path>
                        <!-- Launch the packaged app on a free port instead of the default 8081.
                             8081 is the @QuarkusTest port, and this repo's known flake is exactly a
                             race for it (AGENTS.md) — surefire's last Quarkus instance can still
                             hold it when failsafe starts, which would make the native gate fail for
                             a reason that has nothing to do with the binary. 0 is understood by the
                             launcher: it reads the actual port back out of the startup line. -->
                        <quarkus.http.test-port>0</quarkus.http.test-port>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- GraalVM native build (the profile qits-gateway and qits-workspace-daemon already carry):
             `-Dnative` turns the fast-jar off and the native image on. It lives in THIS module, not
             the root pom, because only this module is an application — `ci` is a library jar with
             nothing to native-compile. skipITs flips with it so the build runs
             CiPackagedSurfaceIT against the binary it just produced rather than packaging one
             nobody starts; qits.it.excluded-groups keeps the docker-and-network-dependent
             docker-backed gates out of that (root pom). -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
                <qits.it.excluded-groups>extended</qits.it.excluded-groups>
            </properties>
        </profile>
    </profiles>
</project>
