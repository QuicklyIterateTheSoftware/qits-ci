<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-ci</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The CI pipeline domain: the in-repo `.config/qits/ci-<event>.yml` pipelines as a quality
         gate. A plain library jar: entities, persistence, control, mapper, dto — NO web/JAX-RS
         (that is `service`). Runs reference repositories/branches by *String id/name* (never a JPA
         @ManyToOne into another context's tables) and this context talks to the rest of qits only
         over the surfaces it declares: the git host's smart-HTTP URL and its own docker CLI
         shell-out.

         It owns its OWN named datasource + persistence unit + Flyway lineage — a separate
         file-based H2 under ~/.qits/data/ci (see src/main/resources/META-INF/microprofile-config.properties).
         That lineage is carried over from the monorepo UNCHANGED (`db/ci/migration/V1__init.sql`);
         it was never part of the monorepo's shared V1-V45 lineage, so there was nothing to squash.

         The directory stays `ci/` (the extracted git history is anchored to it) while the
         artifactId is `qits-ci-domain`: this module is the domain layer of the qits-ci repo, and
         `eu.wohlben.qits:qits-ci-ci` would be nonsense. -->
    <artifactId>qits-ci-domain</artifactId>
    <name>qits-ci :: domain</name>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <!-- ObjectMapper bean availability for consumers (no REST needed). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <!-- Parses the repo-committed ci-post-receive.yml (SafeConstructor — plain maps/lists
                 only, never instantiating classes from repository content). Version managed by the
                 Quarkus BOM. -->
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- The consuming Quarkus app needs an index of this jar's beans and entities; in
                     the monorepo the reactor's own module discovery covered it. -->
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
