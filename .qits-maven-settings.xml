<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <!-- Exact repository-id matches win over Maven's external:http:* blocker. This permits only
         the platform's own repository URL supplied to the image build, not arbitrary HTTP repos. -->
    <mirror>
      <id>qits-maven-network</id>
      <mirrorOf>qits-maven</mirrorOf>
      <url>${env.QITS_MAVEN_REPOSITORY_URL}</url>
    </mirror>
  </mirrors>
  <servers>
    <!-- The credential that answers the registry's 401 once reads are gated. The id is the MIRROR's
         id, because a mirror is the server Maven authenticates against. Maven presents a server's
         username and password only when a repository challenges, so while reads are anonymous —
         today, and for any in-network build that never sees a 401 — these two lines are unused
         literals: an unset variable stays unexpanded and is never sent anywhere. The image build
         supplies both from BuildKit secret mounts; see docker/Dockerfile. -->
    <server>
      <id>qits-maven-network</id>
      <username>${env.QITS_MAVEN_AUTH_USR}</username>
      <password>${env.QITS_MAVEN_AUTH_PSW}</password>
    </server>
  </servers>
</settings>
