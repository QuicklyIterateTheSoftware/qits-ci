<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Standalone parent for the extracted qits-ci repo (docs/epics/qits-ci/ in the qits
         monorepo). The in-repo CI pipeline: a repository opts in by committing
         `.config/qits/ci-post-receive.yml`, an HTTP post-receive event arrives from the git host,
         ci reads the config back out of the pushed commit over the git host's smart-HTTP URL, runs
         each step's script in a fresh container, and records an advisory pass/fail per push.

         This context is HOST-SIDE by design and lives outside any workspace container: it starts
         one ephemeral step container per step on its own network — each running a qits-ci-daemon
         that dials back and executes the step as its own child — and GitConfigFetcher keeps its own
         bare git cache. qits-ci itself executes nothing. That is the boundary, not an accident of
         the monorepo.

         DELIBERATELY ITS OWN GAV, the qits-workspaces case rather than the qits-workspace-daemon
         one. The child directories are `ci` and `service`, generic names that would collide in the
         shared ~/.m2 (and the qits_shared_m2 volume every workspace container mounts) with the
         monorepo's own `eu.wohlben:ci` / `eu.wohlben:service`. So the coordinates are namespaced
         (`eu.wohlben.qits:qits-ci-*`) while the DIRECTORIES stay `ci/` and `service/` — the
         filtered git history is anchored to those paths and renaming them would sever it.

         Versions that must stay in step with qits (Quarkus platform, JDK release, MapStruct,
         Lombok) are duplicated here on purpose: a clone of THIS repo alone must build, with no
         monorepo and no parent to inherit from.

         Trimmed to what these two modules actually need. The monorepo's app-wide machinery is
         intentionally omitted: spotless, enforcer, the :8080 dev-mode port guard, isolated-test
         surefire chunking, the derive-fixture-bares antrun step, the maven build-cache extension,
         and the mandatory -Dqits.variant=oauth|forwardauth|local auth profiles. -->
    <groupId>eu.wohlben.qits</groupId>
    <artifactId>qits-ci</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>qits-ci</name>

    <modules>
        <!-- Listed first: `service` depends on all four. `eventstream` and `ci-events` come
             before `ci` because that is the direction of the dependency arrow — ci-events depends
             on eventstream and on nothing else, eventstream depends on nothing of ours at all.
             (Maven computes the reactor order itself; the listing is documentation.)

             `eventstream` is a SUBMODULE — the qits-eventstream repository, checked out here so
             the reactor can build it in place. Its pom is parentless and carries its own groupId
             and version; the reactor resolves it as a module all the same. A clone that has not
             initialised its submodules has no such directory and the build fails at once, which is
             the intended signal. (An XML comment may not contain two consecutive dashes, so the
             git command that fixes it is spelled out in AGENTS.md rather than here.) -->
        <module>ci-daemon-protocol</module>
        <module>eventstream</module>
        <module>ci-events</module>
        <module>ci</module>
        <module>service</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.34.6</quarkus.platform.version>

        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <failsafe-plugin.version>3.5.4</failsafe-plugin.version>
        <jandex-plugin.version>3.4.0</jandex-plugin.version>
        <lombok.version>1.18.38</lombok.version>
        <!-- Quinoa is a quarkiverse extension and is not in the platform BOM, so it carries its own
             version. Used by `service` only; see the dependency's comment there for why 2.8.2 and
             not the newer 2.8.3. -->
        <quinoa.version>2.8.2</quinoa.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <mapstruct.version>1.6.3</mapstruct.version>

        <!-- The docker-backed ITs (CiDaemonHandshakeIT, CiDaemonGateIT) need real docker, a real
             step image and a built qits-ci-daemon binary, none of which a fresh clone has. `mvn
             verify` must be green without them — the same default the monorepo and qits-workspaces
             carry. Run them with -DskipITs=false. `service`'s `native` profile also flips it, so a
             `-Dnative` build exercises the binary it just compiled instead of packaging it and
             asserting nothing. -->
        <skipITs>true</skipITs>

        <!-- JUnit tags failsafe must NOT run, empty by default so `-DskipITs=false` still means
             "run everything", which is what AGENTS.md documents. Only the `native` profile sets it,
             to `extended`: that build wants the @QuarkusIntegrationTest against the binary, and the
             docker-backed ITs — tagged `extended`, needing real docker AND a step container that can
             route back to the JVM — are infrastructure tests that have nothing to say about
             native-image and fail rather than skip on a plain WSL2 host. Excluding them there keeps
             the native gate about the binary; they are still run, unchanged, by -DskipITs=false. -->
        <qits.it.excluded-groups/>
        <!-- Surefire's @{argLine} has no value unless something (jacoco/quarkus) sets it. -->
        <argLine/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- org.yaml:snakeyaml (CiConfigParser's SafeConstructor) is managed by the Quarkus
                 BOM, so it stays version-less in the child pom exactly as in the monorepo. -->
            <!-- The reactor's own modules, so `service` depends on them version-less. -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-ci-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-ci-daemon-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-eventstream</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-ci-events</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                        <!-- Incremental compilation leaves stale MapStruct *Impl classes behind
                             when a mapper's shape changes; the monorepo disables it for the same
                             reason. -->
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.smallrye</groupId>
                    <artifactId>jandex-maven-plugin</artifactId>
                    <version>${jandex-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>make-index</id>
                            <goals>
                                <goal>jandex</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
